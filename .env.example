# ==========================================
# BREVO CRM & EMAIL CONFIGURATION
# ==========================================
# Required for Brevo HTTPS API calls to /v3/smtp/email and /v3/contacts.
# This is not the SMTP relay password/key.
BREVO_API_KEY=
BREVO_IS_EMAIL_ENABLED=false
BREVO_SENDER_EMAIL=hello@example.com
BREVO_SENDER_NAME="The Neighbourhood Cocktails"
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_API_KEY=

# ==========================================
# BOOKING SYSTEM CONFIGURATION
# ==========================================
BOOKING_RECIPIENT_EMAIL=bookings@example.com

# Optional: Brevo List ID where all new booking leads are automatically saved.
BREVO_CONTACT_LIST_ID=

# ==========================================
# GUEST FEEDBACK SYSTEM BUCKETS
# ==========================================
# The Brevo List ID for advocates who rate the drink >= 4 and recommend Yes.
BREVO_PROMOTERS_LIST_ID=

# The Brevo List ID for critiques who rate the drink <= 2 or recommend No.
BREVO_CRITIQUES_LIST_ID=

# The Brevo List ID for visitors who opt-in to popup alerts via email.
BREVO_POPUPS_LIST_ID=

# ==========================================
# SANITY CONTENT STUDIO
# ==========================================
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-19
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# ==========================================
# META PIXEL & CONVERSIONS API
# ==========================================
# Browser tracking uses the consent-gated Pixel ID in the application.
# Keep the Conversions API token server-side; never prefix it with NEXT_PUBLIC_.
META_PIXEL_ID=2277689509707110
META_CONVERSIONS_API_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Optional while validating server events in Meta Events Manager.
# Remove this value before relying on production reporting.
META_TEST_EVENT_CODE=
