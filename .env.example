# ==========================================
# BREVO CRM & EMAIL CONFIGURATION
# ==========================================
# Required for Brevo HTTPS API calls to /v3/smtp/email and /v3/contacts.
# This is not the SMTP relay password/key.
BREVO_API_KEY=
BREVO_IS_EMAIL_ENABLED=false
BREVO_SENDER_EMAIL=hello@example.com
BREVO_SENDER_NAME="The Neighbourhood Cocktails"
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_API_KEY=

# ==========================================
# BOOKING SYSTEM CONFIGURATION
# ==========================================
BOOKING_RECIPIENT_EMAIL=bookings@example.com

# Optional: Brevo List ID where all new booking leads are automatically saved.
BREVO_CONTACT_LIST_ID=

# ==========================================
# GUEST FEEDBACK SYSTEM BUCKETS
# ==========================================
# The Brevo List ID for advocates who rate the drink >= 4 and recommend Yes.
BREVO_PROMOTERS_LIST_ID=

# The Brevo List ID for critiques who rate the drink <= 2 or recommend No.
BREVO_CRITIQUES_LIST_ID=

# The Brevo List ID for visitors who opt-in to popup alerts via email.
BREVO_POPUPS_LIST_ID=